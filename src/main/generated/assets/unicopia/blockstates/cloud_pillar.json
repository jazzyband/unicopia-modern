{
  "multipart": [
    {
      "apply": {
        "model": "unicopia:block/cloud_pillar",
        "x": 90,
        "y": 90
      },
      "when": {
        "axis": "x"
      }
    },
    {
      "apply": {
        "model": "unicopia:block/cloud_pillar_end",
        "x": 270,
        "y": 90
      },
      "when": {
        "axis": "x",
        "north": "false"
      }
    },
    {
      "apply": {
        "model": "unicopia:block/cloud_pillar_end",
        "x": 90,
        "y": 90
      },
      "when": {
        "axis": "x",
        "south": "false"
      }
    },
    {
      "apply": {
        "model": "unicopia:block/cloud_pillar"
      },
      "when": {
        "axis": "y"
      }
    },
    {
      "apply": {
        "model": "unicopia:block/cloud_pillar_end",
        "x": 180
      },
      "when": {
        "axis": "y",
        "north": "false"
      }
    },
    {
      "apply": {
        "model": "unicopia:block/cloud_pillar_end"
      },
      "when": {
        "axis": "y",
        "south": "false"
      }
    },
    {
      "apply": {
        "model": "unicopia:block/cloud_pillar",
        "x": 90
      },
      "when": {
        "axis": "z"
      }
    },
    {
      "apply": {
        "model": "unicopia:block/cloud_pillar_end",
        "x": 90
      },
      "when": {
        "axis": "z",
        "north": "false"
      }
    },
    {
      "apply": {
        "model": "unicopia:block/cloud_pillar_end",
        "x": 270
      },
      "when": {
        "axis": "z",
        "south": "false"
      }
    }
  ]
}